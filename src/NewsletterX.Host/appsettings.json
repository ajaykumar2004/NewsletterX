{
  // =============================================================================
  // NewsletterX Configuration
  // =============================================================================
  // ARCHITECTURAL DECISION: Configuration Structure
  // ─────────────────────────────────────────────────
  // - Each section maps to a strongly-typed Options class
  // - Secrets (passwords, JWT keys) use placeholders — override via:
  //   1. appsettings.{Environment}.json
  //   2. Environment variables (e.g., ConnectionStrings__DefaultConnection)
  //   3. AWS Secrets Manager / Azure Key Vault in production
  //
  // NEVER commit real secrets to source control!
  // =============================================================================

  "AllowedHosts": "*",

  // ---------------------------------------------------------------------------
  // Database Configuration
  // ---------------------------------------------------------------------------
  // CONNECTION STRING ANATOMY:
  // - Host: postgres container or RDS endpoint
  // - Port: 5432 (PostgreSQL default)
  // - Database: newsletterx
  // - Username/Password: Override in environment-specific config
  //
  // POOL SETTINGS (Critical for Production):
  // - Max Pool Size: Max concurrent connections per connection string
  // - Min Pool Size: Keep-alive connections (avoids cold start)
  // - Connection Idle Lifetime: Close idle connections after N seconds
  // - Connection Pruning Interval: How often to check for idle connections
  //
  // RULE OF THUMB: Max Pool Size = (Number of CPU cores × 2) + Disk spindles
  // For cloud DBs: Start with 20-50, monitor, adjust
  // ---------------------------------------------------------------------------
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5432;Database=newsletterx;Username=newsletterx;Password=newsletterx_dev_password;Max Pool Size=50;Min Pool Size=5;Connection Idle Lifetime=300;Connection Pruning Interval=10;Include Error Detail=true"
  },

  // ---------------------------------------------------------------------------
  // JWT Authentication Configuration
  // ---------------------------------------------------------------------------
  // SECURITY DECISIONS:
  // - Issuer/Audience: Validate these to prevent token reuse across services
  // - AccessTokenExpirationMinutes: Short-lived (15-60 min) for security
  // - SecretKey: Must be 256+ bits for HS256, override in production!
  //
  // WHY JWT over Session Cookies?
  // - Stateless: No server-side session storage needed
  // - Scalable: Any instance can validate (with shared secret)
  // - Mobile-friendly: Works without cookie support
  //
  // PRODUCTION GOTCHA: Use asymmetric keys (RS256) for multi-service auth
  // HS256 requires sharing the secret; RS256 uses public/private keys
  // ---------------------------------------------------------------------------
  "JwtSettings": {
    "Issuer": "NewsletterX",
    "Audience": "NewsletterX",
    "SecretKey": "CHANGE_THIS_IN_PRODUCTION_MUST_BE_AT_LEAST_32_CHARACTERS_LONG",
    "AccessTokenExpirationMinutes": 60
  },

  // ---------------------------------------------------------------------------
  // AWS Configuration
  // ---------------------------------------------------------------------------
  // LOCALSTACK SETUP:
  // - ServiceURL points to LocalStack gateway (port 4566)
  // - UseHttp: LocalStack doesn't use HTTPS locally
  // - Region: Must match LocalStack region (us-east-1 default)
  //
  // FOR PRODUCTION:
  // - Remove ServiceURL (SDK auto-discovers endpoints)
  // - Credentials via IAM role (ECS task role, Lambda execution role)
  // - Never use access keys in production config
  //
  // CLIENT REUSE (Critical):
  // - AWS SDK clients MUST be singletons
  // - They manage internal HTTP connection pools
  // - Creating per-request = socket exhaustion under load
  // ---------------------------------------------------------------------------
  "AWS": {
    "Region": "us-east-1",
    "ServiceURL": "http://localhost:4566",
    "UseHttp": true
  },

  // ---------------------------------------------------------------------------
  // SNS Configuration
  // ---------------------------------------------------------------------------
  "Sns": {
    "NewsletterDispatchTopicArn": "arn:aws:sns:us-east-1:000000000000:newsletter-dispatch"
  },

  // ---------------------------------------------------------------------------
  // SQS Configuration
  // ---------------------------------------------------------------------------
  // QUEUE SETTINGS:
  // - MaxNumberOfMessages: Batch size for ReceiveMessage (1-10)
  // - WaitTimeSeconds: Long polling duration (max 20s)
  // - VisibilityTimeoutSeconds: How long message is invisible after receive
  //
  // LONG POLLING (WaitTimeSeconds > 0):
  // - Reduces empty responses (and API costs)
  // - Single long-poll vs many short-polls
  // - Set to 20s unless you need faster response to new messages
  //
  // VISIBILITY TIMEOUT:
  // - Must exceed max processing time
  // - If processing fails, message becomes visible again
  // - Too short = duplicate processing; too long = slow retry
  // ---------------------------------------------------------------------------
  "Sqs": {
    "EmailSendQueueUrl": "http://localhost:4566/000000000000/email-send-queue",
    "AuditLogQueueUrl": "http://localhost:4566/000000000000/audit-log-queue",
    "MaxNumberOfMessages": 10,
    "WaitTimeSeconds": 20,
    "VisibilityTimeoutSeconds": 30
  },

  // ---------------------------------------------------------------------------
  // DynamoDB Configuration
  // ---------------------------------------------------------------------------
  // TTL: Records auto-delete after this many days
  // Actual deletion may take up to 48 hours after TTL expiry
  // ---------------------------------------------------------------------------
  "DynamoDB": {
    "EmailDispatchLogTableName": "EmailDispatchLog",
    "TtlDays": 90
  },

  // ---------------------------------------------------------------------------
  // Rate Limiting Configuration
  // ---------------------------------------------------------------------------
  // STRATEGY: Fixed Window
  // - Window: Time period for rate limit
  // - PermitLimit: Max requests per window
  // - QueueLimit: Requests to queue when limit hit (0 = reject immediately)
  //
  // WHY RATE LIMIT AUTH ENDPOINTS?
  // - Brute-force protection for login
  // - Prevents credential stuffing attacks
  // - Protects against registration spam
  //
  // PRODUCTION: Consider distributed rate limiting (Redis-backed)
  // In-memory rate limiting doesn't work across multiple instances
  // ---------------------------------------------------------------------------
  "RateLimiting": {
    "Auth": {
      "WindowSeconds": 60,
      "PermitLimit": 10,
      "QueueLimit": 0
    }
  },

  // ---------------------------------------------------------------------------
  // Newsletter Dispatch Job Configuration
  // ---------------------------------------------------------------------------
  // CRON FORMAT: "second minute hour day-of-month month day-of-week"
  // "0 0 9 * * 1" = Every Monday at 9:00 AM
  //
  // BatchSize: Subscribers per SNS message (balance between throughput and size)
  // ---------------------------------------------------------------------------
  "NewsletterDispatch": {
    "CronExpression": "0 0 9 * * 1",
    "BatchSize": 100,
    "Enabled": true
  },

  // ---------------------------------------------------------------------------
  // Serilog Configuration
  // ---------------------------------------------------------------------------
  // STRUCTURED LOGGING:
  // - Every log has properties (CorrelationId, UserId, etc.)
  // - Searchable in log aggregators (Seq, CloudWatch Logs Insights)
  // - JSON format for machine parsing
  //
  // ENRICHERS:
  // - FromLogContext: Includes properties added via LogContext.PushProperty
  // - Environment: Adds MachineName, EnvironmentName
  // - Thread: Adds ThreadId (useful for async debugging)
  //
  // MINIMUM LEVEL:
  // - Override per namespace to reduce noise
  // - Microsoft.* and System.* at Warning to filter framework logs
  // ---------------------------------------------------------------------------
  "Serilog": {
    "Using": [
      "Serilog.Sinks.Console",
      "Serilog.Sinks.File",
      "Serilog.Enrichers.Environment",
      "Serilog.Enrichers.Thread"
    ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "Microsoft.EntityFrameworkCore.Database.Command": "Warning",
        "System": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] {CorrelationId} | {Message:lj}{NewLine}{Exception}"
        }
      },
      {
        "Name": "File",
        "Args": {
          "path": "logs/newsletterx-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 7,
          "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} [{Level:u3}] {CorrelationId} | {SourceContext} | {Message:lj}{NewLine}{Exception}"
        }
      }
    ],
    "Enrich": [
      "FromLogContext",
      "WithMachineName",
      "WithEnvironmentName",
      "WithThreadId"
    ],
    "Properties": {
      "Application": "NewsletterX"
    }
  }
}
