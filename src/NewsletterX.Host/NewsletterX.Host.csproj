<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <DockerDefaultTargetOS>Linux</DockerDefaultTargetOS>
  </PropertyGroup>

  <!--
    ARCHITECTURAL DECISION: Host Project (Composition Root)
    ═══════════════════════════════════════════════════════
    This is the "Composition Root" — where all dependencies are wired together.
    Contains: Program.cs, appsettings.json, Dockerfile, DI registration, Background services.
    
    Why is this the only "runnable" project?
    - Single entry point simplifies deployment
    - All configuration lives here (appsettings, secrets)
    - Background services (IHostedService) are registered here
    
    Package Choices:
    ─────────────────
    - Serilog: Structured logging with sinks (Console, File, Seq, CloudWatch)
    - Swashbuckle: Swagger/OpenAPI generation
    - AspNetCore.HealthChecks: Standard health check infrastructure
    - EF Core Design: Enables `dotnet ef migrations` commands
    
    TRANSFERABLE PATTERN: The Host references ALL other projects but contains
    minimal code — just DI registration and startup. Business logic stays out.
  -->

  <ItemGroup>
    <!-- Serilog for structured logging -->
    <PackageReference Include="Serilog.AspNetCore" Version="8.0.3" />
    <PackageReference Include="Serilog.Enrichers.Environment" Version="3.0.1" />
    <PackageReference Include="Serilog.Enrichers.Thread" Version="4.0.0" />
    <PackageReference Include="Serilog.Settings.Configuration" Version="8.0.4" />
    <PackageReference Include="Serilog.Sinks.Console" Version="6.0.0" />
    <PackageReference Include="Serilog.Sinks.File" Version="6.0.0" />

    <!-- Swagger / OpenAPI -->
    <PackageReference Include="Swashbuckle.AspNetCore" Version="7.2.0" />

    <!-- Health Checks -->
    <PackageReference Include="AspNetCore.HealthChecks.NpgSql" Version="8.0.2" />
    <PackageReference Include="AspNetCore.HealthChecks.Aws.Sqs" Version="8.0.1" />

    <!-- EF Core tooling for migrations -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="8.0.11">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>

    <!-- AWS SDK configuration -->
    <PackageReference Include="AWSSDK.Extensions.NETCore.Setup" Version="3.7.301" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\NewsletterX.Api\NewsletterX.Api.csproj" />
    <ProjectReference Include="..\NewsletterX.Providers\NewsletterX.Providers.csproj" />
    <ProjectReference Include="..\NewsletterX.Repositories\NewsletterX.Repositories.csproj" />
    <ProjectReference Include="..\NewsletterX.EntityModels\NewsletterX.EntityModels.csproj" />
    <ProjectReference Include="..\NewsletterX.ContractModels\NewsletterX.ContractModels.csproj" />
    <ProjectReference Include="..\NewsletterX.Types\NewsletterX.Types.csproj" />
  </ItemGroup>

</Project>
