<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!--
    NuGet Configuration for NewsletterX
    ====================================
    This config file ensures packages are restored from nuget.org.
    Place this at the solution root to override any machine-level NuGet config.
  -->
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
</configuration>

